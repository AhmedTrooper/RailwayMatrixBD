{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Railway Matrix BD",
  "version": "0.9.1",
  "identifier": "com.railway-matrix-sutsoa.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Tailway Matrix BD",
        "width": 800,
        "height": 600,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "minWidth": 300,
        "minHeight": 400
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "versionCode": 9
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/AhmedTrooper/RailwayMatrixBD/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZDMDc1MzA1OEFGNjI2NjgKUldSb0p2YUtCVk1IL0dnZ1JpNXlCeERaa09ueENJS2U3WlFhTHJqd3FlSU5SRVY5ZU9mQ1hlYlEK"
    }
  }
}
